{"session_id": "b3_dev_suppress_01", "seq": 17, "t_rel_s": 2.07, "type": "claim_emitted", "wall_clock_ms": 1790441097944.886, "intent_id": "int_3f9b404d", "claim_id": "clm_e2b437e3", "citations": ["DOC_POL_11 §2"], "detail": {"text": "Display assembly replacement for current-generation flagship models is a same-day repair."}}
{"session_id": "b3_dev_suppress_01", "seq": 18, "t_rel_s": 2.07, "type": "claim_emitted", "wall_clock_ms": 1790441097944.9539, "intent_id": "int_3f9b404d", "claim_id": "clm_a5a59a3a", "citations": ["DOC_POL_11 §2"], "detail": {"text": "Older generations and regional variants may require a part order with a three to five working day lead time."}}
{"session_id": "b3_dev_suppress_01", "seq": 19, "t_rel_s": 2.07, "type": "claim_emitted", "wall_clock_ms": 1790441097945.0156, "intent_id": "int_3f9b404d", "claim_id": "clm_6aa9032f", "citations": ["DOC_POL_11 §1"], "detail": {"text": "Walk-in repairs with parts in stock are completed within four working hours."}}
