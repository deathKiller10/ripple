{"session_id": "b3_dev_multi_08", "seq": 41, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.2002, "intent_id": "int_fffee6c9", "claim_id": "clm_5c748012", "citations": ["DOC_KB_13 §1"], "detail": {"text": "Spontaneous phone restarts occur randomly or during specific activities like gaming."}}
{"session_id": "b3_dev_multi_08", "seq": 42, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.3218, "intent_id": "int_fffee6c9", "claim_id": "clm_c12b6846", "citations": ["DOC_KB_13 §2"], "detail": {"text": "Restarts during a single application indicate that specific application is responsible."}}
{"session_id": "b3_dev_multi_08", "seq": 43, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.3787, "intent_id": "int_fffee6c9", "claim_id": "clm_87ef7fdd", "citations": ["DOC_KB_13 §2"], "detail": {"text": "Restarts across unrelated activities or during charging point to power delivery issues."}}
{"session_id": "b3_dev_multi_08", "seq": 44, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.43, "intent_id": "int_fffee6c9", "claim_id": "clm_ec10b02e", "citations": ["DOC_KB_13 §2"], "detail": {"text": "Booting into Safe Mode and using the device for a day helps determine if a third-party app is responsible."}}
{"session_id": "b3_dev_multi_08", "seq": 45, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.4805, "intent_id": "int_fffee6c9", "claim_id": "clm_1797af04", "citations": ["DOC_KB_13 §3"], "detail": {"text": "Escalate cases where restarts reproduce in Safe Mode and quote diagnostic code SYS-011."}}
{"session_id": "b3_dev_multi_08", "seq": 46, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441843371.528, "intent_id": "int_fffee6c9", "claim_id": "clm_bcc4b785", "citations": ["DOC_KB_13 §3"], "detail": {"text": "Devices restarting during charging must be checked against thermal symptoms before customer return."}}
{"session_id": "b3_dev_multi_08", "seq": 47, "t_rel_s": 4.139, "type": "grounding_checked", "wall_clock_ms": 1790441843372.0095, "intent_id": "int_c8187249", "detail": {"stage": "pre_synthesis_relevance", "max_passage_coverage": 0.5, "best_cite": "DOC_KB_13 §2", "query_terms": ["charg", "hot"], "unmatched_terms": ["hot"], "sufficient": true, "reason": "DOC_KB_13 §2 covers 50% of the question's topical terms"}}
{"session_id": "b3_dev_multi_08", "seq": 48, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441879396.522, "intent_id": "int_c8187249", "claim_id": "clm_d286973a", "citations": ["DOC_KB_11 §1"], "detail": {"text": "The device becoming uncomfortably warm during charging is a known symptom."}}
{"session_id": "b3_dev_multi_08", "seq": 49, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441879396.679, "intent_id": "int_c8187249", "claim_id": "clm_c3a9fc94", "citations": ["DOC_KB_11 §1"], "detail": {"text": "Mild warmth during fast charging is normal."}}
{"session_id": "b3_dev_multi_08", "seq": 50, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441879396.7651, "intent_id": "int_c8187249", "claim_id": "clm_5418111a", "citations": ["DOC_KB_11 §1"], "detail": {"text": "An on-screen temperature warning that halts charging is not normal."}}
{"session_id": "b3_dev_multi_08", "seq": 51, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790441879396.8745, "intent_id": "int_c8187249", "claim_id": "clm_27c49d4c", "citations": ["DOC_KB_11 §2"], "detail": {"text": "Confirm that a certified charger and cable rated for the device's charging profile are being used."}}
