{"session_id": "b3_dev_multi_05", "seq": 84, "t_rel_s": 9.311, "type": "claim_emitted", "wall_clock_ms": 1790441479538.4846, "intent_id": "int_02bc66c8", "claim_id": "clm_2b3c3cf8", "citations": ["DOC_KB_06 §3"], "detail": {"text": "Camera module replacement for internal debris is covered under the standard warranty if there is no impact damage."}}
