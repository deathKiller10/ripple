{"session_id": "b3_dev_multi_05", "seq": 84, "t_rel_s": 9.311, "type": "claim_emitted", "wall_clock_ms": 1790426663130.8618, "intent_id": "int_1ba4551c", "claim_id": "clm_6d35dd77", "citations": ["DOC_KB_06 §1"], "detail": {"text": "A fixed blurred patch on the camera typically indicates internal debris behind the lens cover."}}
{"session_id": "b3_dev_multi_05", "seq": 85, "t_rel_s": 9.311, "type": "claim_emitted", "wall_clock_ms": 1790426663130.9714, "intent_id": "int_1ba4551c", "claim_id": "clm_34c08ad9", "citations": ["DOC_KB_06 §3", "DOC_KB_06 §2"], "detail": {"text": "Internal debris requires a camera module replacement."}}
{"session_id": "b3_dev_multi_05", "seq": 86, "t_rel_s": 9.311, "type": "claim_emitted", "wall_clock_ms": 1790426663131.0151, "intent_id": "int_1ba4551c", "claim_id": "clm_fa6a2244", "citations": ["DOC_KB_06 §3"], "detail": {"text": "Camera module replacement is covered under the standard warranty if there is no impact damage."}}
{"session_id": "b3_dev_multi_05", "seq": 87, "t_rel_s": 9.311, "type": "claim_emitted", "wall_clock_ms": 1790426663131.058, "intent_id": "int_1ba4551c", "claim_id": "clm_e89c1bbd", "citations": ["DOC_WAR_01 §3"], "detail": {"text": "Camera module failure is covered when it arises without external cause."}}
