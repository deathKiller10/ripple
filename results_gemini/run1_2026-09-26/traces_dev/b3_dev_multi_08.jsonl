{"session_id": "b3_dev_multi_08", "seq": 41, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434098185.0974, "intent_id": "int_109bc1fc", "claim_id": "clm_efa87262", "citations": ["DOC_KB_13 §1"], "detail": {"text": "Spontaneous phone restarts occur with no user action, either randomly or during specific activities like camera use or gaming."}}
{"session_id": "b3_dev_multi_08", "seq": 42, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434098185.2947, "intent_id": "int_109bc1fc", "claim_id": "clm_a14a3c3e", "citations": ["DOC_KB_13 §2"], "detail": {"text": "Restarts during a single application point to that application, while restarts across unrelated activities or during charging point to power delivery."}}
{"session_id": "b3_dev_multi_08", "seq": 43, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434098185.3877, "intent_id": "int_109bc1fc", "claim_id": "clm_9d4788e9", "citations": ["DOC_KB_13 §2"], "detail": {"text": "Booting into Safe Mode and using the device for a day will determine if a third-party application is responsible, as no restarts will occur in Safe Mode if that is the case."}}
{"session_id": "b3_dev_multi_08", "seq": 44, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434098185.4604, "intent_id": "int_109bc1fc", "claim_id": "clm_0ea5feea", "citations": ["DOC_KB_13 §3"], "detail": {"text": "Escalate the issue if restarts reproduce while in Safe Mode, and quote diagnostic code SYS-011."}}
{"session_id": "b3_dev_multi_08", "seq": 45, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434098185.5444, "intent_id": "int_109bc1fc", "claim_id": "clm_86f7371c", "citations": ["DOC_KB_13 §3"], "detail": {"text": "Devices that restart during charging must also be checked against thermal symptoms using DOC_KB_11 §3 before being returned to the customer."}}
{"session_id": "b3_dev_multi_08", "seq": 46, "t_rel_s": 4.139, "type": "grounding_checked", "wall_clock_ms": 1790434098185.9448, "intent_id": "int_cad88501", "detail": {"stage": "pre_synthesis_relevance", "max_passage_coverage": 0.5, "best_cite": "DOC_KB_13 §2", "query_terms": ["charg", "hot"], "unmatched_terms": ["hot"], "sufficient": true, "reason": "DOC_KB_13 §2 covers 50% of the question's topical terms"}}
{"session_id": "b3_dev_multi_08", "seq": 47, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.4636, "intent_id": "int_cad88501", "claim_id": "clm_149800d2", "citations": ["DOC_KB_11 §1"], "detail": {"text": "The device becoming uncomfortably warm during charging is a known symptom."}}
{"session_id": "b3_dev_multi_08", "seq": 48, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.5527, "intent_id": "int_cad88501", "claim_id": "clm_5a24bc82", "citations": ["DOC_KB_11 §1"], "detail": {"text": "Mild warmth during fast charging is normal."}}
{"session_id": "b3_dev_multi_08", "seq": 49, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.613, "intent_id": "int_cad88501", "claim_id": "clm_ee2749e4", "citations": ["DOC_KB_11 §1"], "detail": {"text": "An on-screen temperature warning that halts charging is not normal."}}
{"session_id": "b3_dev_multi_08", "seq": 50, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.6636, "intent_id": "int_cad88501", "claim_id": "clm_64533fa5", "citations": ["DOC_KB_11 §2"], "detail": {"text": "Confirm that the customer uses a certified charger and cable rated for the device profile."}}
{"session_id": "b3_dev_multi_08", "seq": 51, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.7168, "intent_id": "int_cad88501", "claim_id": "clm_3b584576", "citations": ["DOC_KB_11 §2"], "detail": {"text": "Remove any cases during testing, especially magnetic or metal-backed cases."}}
{"session_id": "b3_dev_multi_08", "seq": 52, "t_rel_s": 4.139, "type": "claim_emitted", "wall_clock_ms": 1790434100134.766, "intent_id": "int_cad88501", "claim_id": "clm_a255d7d0", "citations": ["DOC_KB_11 §2"], "detail": {"text": "Charging on a bed or sofa restricts airflow and can cause temperature warnings on healthy devices."}}
