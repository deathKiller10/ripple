{"session_id": "b3_heldout_multi_03", "seq": 60, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894244.0366, "intent_id": "int_2a72e9db", "claim_id": "clm_7f059f9f", "citations": ["DOC_WAR_05 §3"], "detail": {"text": "Devices with an unlocked bootloader, modified system software or a replaced component sourced outside the authorised channel are excluded from warranty coverage for any fault plausibly related to that modification."}}
{"session_id": "b3_heldout_multi_03", "seq": 61, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894244.9019, "intent_id": "int_2a72e9db", "claim_id": "clm_67e77cf4", "citations": ["DOC_PRT_02 §3"], "detail": {"text": "Display assemblies are common across regional variants for the S24 family, so an imported S24 can be repaired with locally stocked parts."}}
{"session_id": "b3_heldout_multi_03", "seq": 62, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894245.719, "intent_id": "int_2a72e9db", "claim_id": "clm_e1332d7f", "citations": ["DOC_KB_07 §1"], "detail": {"text": "A persistent vertical band, usually green but occasionally pink, appearing down one side of the display."}}
{"session_id": "b3_heldout_multi_03", "seq": 63, "t_rel_s": 7.242, "type": "grounding_checked", "wall_clock_ms": 1790524894246.6653, "intent_id": "int_95fe096a", "detail": {"stage": "pre_synthesis_relevance", "max_passage_coverage": 0.5, "best_cite": "DOC_KB_07 §1", "query_terms": ["one", "void"], "unmatched_terms": ["void"], "sufficient": true, "reason": "DOC_KB_07 §1 covers 50% of the question's topical terms"}}
{"session_id": "b3_heldout_multi_03", "seq": 64, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894247.5195, "intent_id": "int_95fe096a", "claim_id": "clm_d58edc82", "citations": ["DOC_KB_16 §3"], "detail": {"text": "This reporting obligation does not depend on whether the customer proceeds with the repair."}}
{"session_id": "b3_heldout_multi_03", "seq": 65, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894248.173, "intent_id": "int_95fe096a", "claim_id": "clm_4f33742d", "citations": ["DOC_KB_07 §1"], "detail": {"text": "The band is present from boot and does not change with brightness or content."}}
{"session_id": "b3_heldout_multi_03", "seq": 66, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894249.174, "intent_id": "int_95fe096a", "claim_id": "clm_0822ab01", "citations": ["DOC_WAR_11 §1"], "detail": {"text": "The service centre does not translate and does not pay for translation."}}
{"session_id": "b3_heldout_multi_03", "seq": 67, "t_rel_s": 7.242, "type": "grounding_checked", "wall_clock_ms": 1790524894250.0393, "intent_id": "int_7fa2867b", "detail": {"stage": "pre_synthesis_relevance", "max_passage_coverage": 0.75, "best_cite": "DOC_POL_07 §2", "query_terms": ["declin", "diagnostic", "fee", "quote"], "unmatched_terms": ["quote"], "sufficient": true, "reason": "DOC_POL_07 §2 covers 75% of the question's topical terms"}}
{"session_id": "b3_heldout_multi_03", "seq": 68, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894250.7764, "intent_id": "int_7fa2867b", "claim_id": "clm_4bf93aa0", "citations": ["DOC_POL_07 §2"], "detail": {"text": "A diagnostic fee of four hundred rupees applies where the customer declines the quotation."}}
{"session_id": "b3_heldout_multi_03", "seq": 69, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894251.7896, "intent_id": "int_7fa2867b", "claim_id": "clm_fb1f0af8", "citations": ["DOC_SVC_09 §2"], "detail": {"text": "The customer may accept the chargeable repair, decline and pay the diagnostic fee under DOC_POL_07 §2, or escalate under DOC_SVC_04."}}
{"session_id": "b3_heldout_multi_03", "seq": 70, "t_rel_s": 7.242, "type": "claim_emitted", "wall_clock_ms": 1790524894252.5618, "intent_id": "int_7fa2867b", "claim_id": "clm_cc4722bb", "citations": ["DOC_POL_23 §1"], "detail": {"text": "The two hundred rupee handling fee is withdrawn entirely."}}
